# OpenAI
OPENAI_API_KEY=

# Supabase — A(노준영)가 5/5에 프로젝트 생성 후 팀 채널에 공유
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=        # Flutter Web (public, RLS 전제)
SUPABASE_SERVICE_ROLE_KEY= # Backend/Agent 전용 (서버 사이드만, 절대 FE에 노출 금지)

# Supabase pooler URL — psycopg 시딩/마이그레이션용 (반드시 6543 포트)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
